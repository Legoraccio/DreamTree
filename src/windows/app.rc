#include <windows.h>

1 ICON "mangrove.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Mangrove - native Git client"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "ProductName", "Mangrove"
            VALUE "ProductVersion", "1.1.0.0"
            VALUE "InternalName", "Mangrove"
            VALUE "OriginalFilename", "Mangrove.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
